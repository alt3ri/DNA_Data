{
  "10101": {
    "Content": "快来看，这里有个缺口",
    "DialogueId": 10101,
    "GUID": "00067932",
    "NextDialogue": 10102,
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/101/00067932"
  },
  "10102": {
    "Content": "嗯，这个缺口的切角好整齐，感觉刚好可以插进一把剑",
    "DialogueId": 10102,
    "ExStoryInfo": "Player",
    "GUID": "0006795C",
    "NextDialogue": 10103,
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/101/0006795C"
  },
  "10103": {
    "Content": "我来试试...果然，刚好没过剑身，像是个“钥匙孔”。",
    "DialogueId": 10103,
    "GUID": "00067986",
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/101/00067986"
  },
  "10201": {
    "Content": "我来转动剑柄试试",
    "DialogueId": 10201,
    "ExStoryInfo": "Player",
    "GUID": "0006899A",
    "NextDialogue": 10202,
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/102/0006899A"
  },
  "10202": {
    "Content": "（远处传来了一声闷响，接着眼前的石门缓缓打开）",
    "DialogueId": 10202,
    "GUID": "000689C4",
    "NextDialogue": 10203,
    "VoiceName": "voice/ch/story/0/102/000689C4"
  },
  "10203": {
    "Content": "原来这把剑就是开门的钥匙",
    "DialogueId": 10203,
    "GUID": "000689EE",
    "NextDialogue": 10204,
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/102/000689EE"
  },
  "10204": {
    "Content": "我们进去看看吧",
    "DialogueId": 10204,
    "ExStoryInfo": "Player",
    "GUID": "00068A18",
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/102/00068A18"
  },
  "10301": {
    "Content": "还是先把剑拔出来吧，这是我们仅存的武器了",
    "DialogueId": 10301,
    "ExStoryInfo": "Player",
    "GUID": "00069A02",
    "NextDialogue": 10302,
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/103/00069A02"
  },
  "10302": {
    "Content": "嗯，我再去四周看看有什么出口",
    "DialogueId": 10302,
    "GUID": "00069A2C",
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/103/00069A2C"
  },
  "10401": {
    "Camera": "185.064941,-192.025635,95.836349,0.000066,-0.600804,133.19693,70.0,100000.0,false,DoNotOverride,2.8",
    "Content": "我是引导员……………………哦吼！",
    "DialogueId": 10401,
    "Duration": 4,
    "ExStoryInfo": "Player",
    "GUID": "0006AA6A",
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/104/0006AA6A"
  },
