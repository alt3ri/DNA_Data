{
  "10101": {
    "Content": "快来看，这里有个缺口",
    "DialogueId": 10101,
    "GUID": "00067932",
    "NextDialogue": 10102,
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/101/00067932"
  },
  "10102": {
    "Content": "嗯，这个缺口的切角好整齐，感觉刚好可以插进一把剑",
    "DialogueId": 10102,
    "ExStoryInfo": "Player",
    "GUID": "0006795C",
    "NextDialogue": 10103,
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/101/0006795C"
  },
  "10103": {
    "Content": "我来试试...果然，刚好没过剑身，像是个“钥匙孔”。",
    "DialogueId": 10103,
    "GUID": "00067986",
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/101/00067986"
  },
  "10201": {
    "Content": "我来转动剑柄试试",
    "DialogueId": 10201,
    "ExStoryInfo": "Player",
    "GUID": "0006899A",
    "NextDialogue": 10202,
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/102/0006899A"
  },
  "10202": {
    "Content": "（远处传来了一声闷响，接着眼前的石门缓缓打开）",
    "DialogueId": 10202,
    "GUID": "000689C4",
    "NextDialogue": 10203,
    "VoiceName": "voice/ch/story/0/102/000689C4"
  },
  "10203": {
    "Content": "原来这把剑就是开门的钥匙",
    "DialogueId": 10203,
    "GUID": "000689EE",
    "NextDialogue": 10204,
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/102/000689EE"
  },
  "10204": {
    "Content": "我们进去看看吧",
    "DialogueId": 10204,
    "ExStoryInfo": "Player",
    "GUID": "00068A18",
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/102/00068A18"
  },
  "10301": {
    "Content": "还是先把剑拔出来吧，这是我们仅存的武器了",
    "DialogueId": 10301,
    "ExStoryInfo": "Player",
    "GUID": "00069A02",
    "NextDialogue": 10302,
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/103/00069A02"
  },
  "10302": {
    "Content": "嗯，我再去四周看看有什么出口",
    "DialogueId": 10302,
    "GUID": "00069A2C",
    "SpeakNpcId": 100003,
    "VoiceName": "voice/ch/story/0/103/00069A2C"
  },
  "10401": {
    "Camera": "185.064941,-192.025635,95.836349,0.000066,-0.600804,133.19693,70.0,100000.0,false,DoNotOverride,2.8",
    "Content": "我是引导员……………………哦吼！",
    "DialogueId": 10401,
    "Duration": 4,
    "ExStoryInfo": "Player",
    "GUID": "0006AA6A",
    "SpeakNpcId": 100001,
    "VoiceName": "voice/ch/story/0/104/0006AA6A"
  },
  "10501": {
    "Content": "我是路人NPC看向功能测试台本",
    "DialogueId": 10501,
    "GUID": "0006BAD2",
    "LookAt": [
      "700001:n(0)"
    ],
    "NextDialogue": 10502,
    "SpeakNpcId": 700001
  },
  "10502": {
    "Content": "我是路人NPC转向功能测试台本",
    "DialogueId": 10502,
    "GUID": "0006BAFC",
    "SpeakNpcId": 700001,
    "TurnTo": [
      "700001:n(0)"
    ]
  },
  "730001": {
    "Content": "不知谁画下的格子图案，似乎与泪湖那边的几块浮冰存在着对应关系。如果按照顺序踩掉那些浮冰的话，或许会发生一些神奇的事。",
    "DialogueId": 730001,
    "GUID": "01D3D5CA",
    "SpeakNpcId": 810001
  },
  "1000101": {
    "Content": "村子可能还是很危险，一定要小心。",
    "DialogueId": 1000101,
    "ExStoryInfo": "Player",
    "GUID": "0280EF12",
    "SpeakNpcId": 100001,
    "VoiceName": "voice/$Locale$/story/1001/10001/0280EF12"
  },
  "1000201": {
    "Content": "自投罗网么？简直愚钝得可爱。",
    "DialogueId": 1000201,
    "GUID": "0280FF7A",
    "SpeakNpcId": 100005,
    "VoiceName": "voice/$Locale$/story/1001/10002/0280FF7A"
  },
  "6100101": {
    "ContentJP": "原因は分からないが、焚火の近くに水仙花が咲き乱れる水域が現れた。\nそこで一人の女性が俯き、水面に揺れる影を見つめている。その影はぼんやりとしているのに、どこか美しく、星空さえも魅了してしまうように思える。",
    "DialogueId": 6100101,
    "GUID": "0F455DD2",
    "NextDialogue": 6100102,
    "RougeTalkActorType": 3
  },
  "6100102": {
    "ContentJP": "「私の愛しき人は、一体どこにいるのだろう？」\n「アトラシア大陸を巡り、ルッカの青き群島と<Default note=\"text:カショ\">華胥</>の翠の幽谷を求め、イーザーの微風が木の葉を囁くたび、春のアースガルド峡湾の氷が砕けて光るたび、そこにあなたの面影を追った。」",
    "DialogueId": 6100102,
    "GUID": "0F455DFC",
    "NextDialogue": 6100103,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room301_Char01"
  },
  "6100103": {
    "ContentJP": "「求め続けた愛など、最初から存在しなかった。」\n「私の美貌にふさわしい佳人は、エリュシオンの聖湖の底に今も縛られているのだろう。」\n彼女は湖面に映る自分の影に向かって、独り言のように呟いた。",
    "DialogueId": 6100103,
    "GUID": "0F455E26",
    "NextOptions": [
      6100104,
      6100106
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room301_Char01"
  },
  "6100104": {
    "ContentJP": "「それは、あなたの倒影に過ぎない。」",
    "DialogueId": 6100104,
    "GUID": "0F455E50",
    "IsKeyOption": true,
    "NextDialogue": 6100105,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100105": {
    "ContentJP": "「あなたは誰？通りすがりの旅人さん？」\n彼女は顔を上げ、ちらりとこちらを見た。\n「彼女を助ける方法を見つけられるなら、また私のところに来て。」",
    "DialogueId": 6100105,
    "GUID": "0F455E7A",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room301_Char01"
  },
  "6100106": {
    "ContentJP": "湖の水仙花を採ってみる。",
    "DialogueId": 6100106,
    "GUID": "0F455EA4",
    "IsKeyOption": true,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100201": {
    "ContentJP": "少し離れた場所で、孤独な老人が、積み上げられた武器の間でハンマーを振り続けている。\nハンマーで一撃、万物は黙し。\nハンマーで二撃、炎は躍し。\n近づいても、老人は顔を上げなかった。",
    "DialogueId": 6100201,
    "GUID": "0F456E3A",
    "NextDialogue": 6100202,
    "RougeTalkActorType": 3
  },
  "6100202": {
    "ContentJP": "「また命知らずな輩が来やがったか。」\n「今は何年だい？」",
    "DialogueId": 6100202,
    "GUID": "0F456E64",
    "NextOptions": [
      6100203
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room302_Char01"
  },
  "6100203": {
    "Content": "尝试回答。",
    "DialogueId": 6100203,
    "GUID": "0F456E8E",
    "NextDialogue": 6100204,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100204": {
    "ContentJP": "唇を開き、答えを口にしてみる。しかし──\n今は何年…何年であるべきなのか？\n長き闇の中で過ごしたせいか、時間に対する感覚すら失っていた。",
    "DialogueId": 6100204,
    "GUID": "0F456EB8",
    "NextDialogue": 6100206,
    "RougeTalkActorType": 3
  },
  "6100206": {
    "ContentJP": "彼は、返答を待てなかった。",
    "DialogueId": 6100206,
    "GUID": "0F456F0C",
    "NextDialogue": 6100207,
    "RougeTalkActorType": 3
  },
  "6100207": {
    "ContentJP": "「どうやら、君も同じか。」彼はため息をついた。\n「ここに囚われて、もうどれくらい経ったのか忘れちまっとる。ここで掴めるもんは、何一つ残っちゃいない──顔に刻まれた皺と、この鉄槌くらいのもんさ。」",
    "DialogueId": 6100207,
    "GUID": "0F456F36",
    "NextDialogue": 6100208,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room302_Char01"
  },
  "6100208": {
    "ContentJP": "「火が消えないうちに…さあ、話しなさい。何が望みだ？」",
    "DialogueId": 6100208,
    "GUID": "0F456F60",
    "NextOptions": [
      6100209,
      6100210
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room302_Char01"
  },
  "6100209": {
    "ContentJP": "武器から一つを選びたい。",
    "DialogueId": 6100209,
    "GUID": "0F456F8A",
    "IsKeyOption": true,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100210": {
    "ContentJP": "彼に一つの武器を作ってもらいたい。",
    "DialogueId": 6100210,
    "GUID": "0F456FB4",
    "IsKeyOption": true,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100301": {
    "ContentJP": "歌声が焚火の寂しさを払うように響き始めた。\n一人の女性がゆっくりと歩み寄ってきた。その足取りは羽のようにふわふわとしたが、その声は鳥の鳴き声のようにのびやかだった。",
    "DialogueId": 6100301,
    "GUID": "0F457EA2",
    "NextDialogue": 6100302,
    "RougeTalkActorType": 3
  },
  "6100302": {
    "ContentJP": "強い眠気に襲われた。\n目の前の暗闇が紙のようにくしゃくしゃと丸められ、水に浸されていく…",
    "DialogueId": 6100302,
    "GUID": "0F457ECC",
    "NextDialogue": 6100303,
    "RougeTalkActorType": 3
  },
  "6100303": {
    "ContentJP": "昼下がりの林間の泉をさまよう。\n絨毯のような草地の間を流れるせせらぎの音、生い茂る木々の葉の隙間から差しこむ陽当りが、一斉にこの地に降り注がれる。\n朝露を静かに啜る真っ白なムササビ、瑠璃色の山猫、淡黄色の野ウサギ。彼らが足音に驚くことはない…",
    "DialogueId": 6100303,
    "GUID": "0F457EF6",
    "NextOptions": [
      6100304,
      6100306
    ],
    "RougeTalkActorType": 3
  },
  "6100304": {
    "ContentJP": "一滴の雫を受け取る。",
    "DialogueId": 6100304,
    "GUID": "0F457F20",
    "IsKeyOption": true,
    "NextDialogue": 6100305,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100305": {
    "ContentJP": "あなたは黄昏色に染まった、小さな居酒屋に座っている。\n吟遊詩人がアコーディオンを奏で、帰港した船乗りたちが手拍子を合わせて合唱する。\n海の匂いを帯びた夜風と、麦酒の甘い香りに包まれながら、賑やかな人混みの中央へ歩み出し、陽気な踊りを繰り広げる…",
    "DialogueId": 6100305,
    "GUID": "0F457F4A",
    "NextDialogue": 6100308,
    "RougeTalkActorType": 3
  },
  "6100306": {
    "ContentJP": "一筋の日差しを抱きしめる。",
    "DialogueId": 6100306,
    "GUID": "0F457F74",
    "IsKeyOption": true,
    "NextDialogue": 6100307,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100307": {
    "ContentJP": "あなたは聖堂のステンドグラスの下にうずくまっている。\n巨大な絵像に描かれた白衣の女神が、慈悲深い眼差しであなたを見下ろす。その姿は壮大で、静かで、そして悲しげだった。\n満月の神が色とりどりの光から降り立ち、あなたの額に口づけ、冷たい珠冠が頬に触れた…",
    "DialogueId": 6100307,
    "GUID": "0F457F9E",
    "NextDialogue": 6100308,
    "RougeTalkActorType": 3
  },
  "6100308": {
    "ContentJP": "トン！\n誰かがあなたの額をはじいた。その痛みでぱっちりと目が覚める。",
    "DialogueId": 6100308,
    "GUID": "0F457FC8",
    "NextDialogue": 6100309,
    "RougeTalkActorType": 3
  },
  "6100309": {
    "ContentJP": "「私はエリュシオンで最も優秀な夢紡ぎ職人よ！せっかく美しい夢を紡いでいたのに、あなたは寝ぼけてばかり。それに、銅貨ひとつ払ってないじゃない！」",
    "DialogueId": 6100309,
    "GUID": "0F457FF2",
    "NextDialogue": 6100310,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room303_Char01"
  },
  "6100310": {
    "ContentJP": "「ほら、起きなさい！もう眠らせたりはしないわ！」\n彼女はプンスカとまたあなたの額をピシリとはじいた。",
    "DialogueId": 6100310,
    "GUID": "0F45801C",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room303_Char01"
  },
  "6100401": {
    "ContentJP": "一人の老人が焚火に寄ってきた。彼は手にランタンを持っている。",
    "DialogueId": 6100401,
    "GUID": "0F458F0A",
    "NextDialogue": 6100402,
    "RougeTalkActorType": 3
  },
  "6100402": {
    "ContentJP": "「ふむ…これはこれは！ あなた様も灯りをお持ちで。」\n「だがな、全ての灯はいつか消える。この深淵で灯火を失えば、永遠に迷い、ずっと暗闇に囚われることになるぞ。」",
    "DialogueId": 6100402,
    "GUID": "0F458F34",
    "NextDialogue": 6100403,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room304_Char01"
  },
  "6100403": {
    "ContentJP": "「さあ、予備の灯りをお買いなされ。ほんの小さな明かりでも、これからの旅で、いつかあなたの助けにもなれるかもしれんぞ。」",
    "DialogueId": 6100403,
    "GUID": "0F458F5E",
    "NextOptions": [
      6100404,
      6100406,
      6100408
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room304_Char01"
  },
  "6100404": {
    "ContentJP": "ランタンを購入する。",
    "DialogueId": 6100404,
    "GUID": "0F458F88",
    "IsKeyOption": true,
    "NextDialogue": 6100405,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100405": {
    "ContentJP": "「おお…なんと気前の良い旅人様！星々を司る神の祝福があらんことを。」\n彼は喜色を皺だらけの貌に浮かべながら、こう言った。",
    "DialogueId": 6100405,
    "GUID": "0F458FB2",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room304_Char01"
  },
  "6100406": {
    "ContentJP": "他の品物を尋ねる。",
    "DialogueId": 6100406,
    "GUID": "0F458FDC",
    "IsKeyOption": true,
    "NextDialogue": 6100407,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100407": {
    "ContentJP": "「おお…なんと気前の良い旅人様！星々を司る神の祝福があらんことを。」\n彼はパッと皺だらけ顔をほころばせてそう言った。",
    "DialogueId": 6100407,
    "GUID": "0F459006",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room304_Char01"
  },
  "6100408": {
    "ContentJP": "取引を断る",
    "DialogueId": 6100408,
    "GUID": "0F459030",
    "IsKeyOption": true,
    "NextDialogue": 6100409,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100409": {
    "ContentJP": "「おお！ 豊穣の神よ、この貧しき魂をお救いください。こんな灯り代のために命すら投げうつとは。」\n彼はブツブツと文句を言いながら立ち去った。",
    "DialogueId": 6100409,
    "GUID": "0F45905A",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room304_Char01"
  },
  "6100501": {
    "ContentJP": "「迷い子よ、神々の指し示す道を行け。」",
    "DialogueId": 6100501,
    "GUID": "0F459F72",
    "NextDialogue": 6100502,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room305_Char01"
  },
  "6100502": {
    "ContentJP": "子供たちの合唱が頭の内側で響き回り、焚火の灯りはより大きな光に溶けていく。体が羽のように軽くなった。\n柔らかな風に浮かぶあなたの目の前には、潔白な雲が漂っている。黄金の塔にいる神々は雲の隙間から招待状を送ってくる。",
    "DialogueId": 6100502,
    "GUID": "0F459F9C",
    "NextDialogue": 6100503,
    "RougeTalkActorType": 3
  },
  "6100503": {
    "ContentJP": "「さあ、神々の恩寵を受け入れよ。天の果てにある楽園へ昇れ。下界に未練などないはず。至高な幸福はこの先にある。」",
    "DialogueId": 6100503,
    "GUID": "0F459FC6",
    "NextOptions": [
      6100504,
      6100506,
      6100508
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room305_Char01"
  },
  "6100504": {
    "ContentJP": "地上に留まる",
    "DialogueId": 6100504,
    "GUID": "0F459FF0",
    "IsKeyOption": true,
    "NextDialogue": 6100505,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100505": {
    "ContentJP": "天から降ってくる幸福には、必ず代償が付き物だ。\n当てもなく、実在するかどうかも分からない天国への道より、自分が歩んだ足跡のほうが確かなものだ。",
    "DialogueId": 6100505,
    "GUID": "0F45A01A",
    "RougeTalkActorType": 3
  },
  "6100506": {
    "ContentJP": "恩寵を受け入れる",
    "DialogueId": 6100506,
    "GUID": "0F45A044",
    "IsKeyOption": true,
    "NextDialogue": 6100507,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100507": {
    "ContentJP": "柔らかい雲の抱擁はまるで母の温もり。\n金色の扉がゆっくりと開くと、隙間から神々の一端がちらりと見えてくる。だが雲が散り、気付けば自分は地面に立っていた。",
    "DialogueId": 6100507,
    "GUID": "0F45A06E",
    "NextDialogue": 6100510,
    "RougeTalkActorType": 3
  },
  "6100508": {
    "ContentJP": "雲を掴もうとする",
    "DialogueId": 6100508,
    "GUID": "0F45A098",
    "IsKeyOption": true,
    "NextDialogue": 6100509,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100509": {
    "ContentJP": "あの柔らかそうな雲に伸ばした指先が、突然激しい熱に襲われた。\n光は消え、耳元で風が唸り、初めて自分が落下していることに気づいた。",
    "DialogueId": 6100509,
    "GUID": "0F45A0C2",
    "NextDialogue": 6100510,
    "RougeTalkActorType": 3
  },
  "6100510": {
    "ContentJP": "そうだ、なぜ忘れていたのか。この深淵には、空など端から存在しなかったはずだ。",
    "DialogueId": 6100510,
    "GUID": "0F45A0EC",
    "RougeTalkActorType": 3
  },
  "6100601": {
    "ContentJP": "小さな影がどんどん近付いてくる。\n見えてきたのは、背の低い少女。",
    "DialogueId": 6100601,
    "GUID": "0F45AFDA",
    "NextDialogue": 6100602,
    "RougeTalkActorType": 3
  },
  "6100602": {
    "ContentJP": "「あの…私も…火に…あたらせて？」\nその声は震えている。裾から滴り落ちる水が、ぽたぽたと地面に染み込んでいく──ワンピースはずぶ濡れだった。",
    "DialogueId": 6100602,
    "GUID": "0F45B004",
    "NextDialogue": 6100603,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100603": {
    "ContentJP": "「お母さんと…はぐれちゃって…もう…すこし…だけ…」",
    "DialogueId": 6100603,
    "GUID": "0F45B02E",
    "NextOptions": [
      6100604,
      6100613
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100604": {
    "ContentJP": "受け入れる。",
    "DialogueId": 6100604,
    "GUID": "0F45B058",
    "IsKeyOption": true,
    "NextDialogue": 6100605,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100605": {
    "ContentJP": "「ありがとう。」\n彼女は震えながら、感謝の言葉を必死に歯の隙間から絞りだす。",
    "DialogueId": 6100605,
    "GUID": "0F45B082",
    "NextDialogue": 6100606,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100606": {
    "ContentJP": "「彼女がここにいる理由を尋ねる」",
    "DialogueId": 6100606,
    "GUID": "0F45B0AC",
    "NextDialogue": 6100607,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100607": {
    "ContentJP": "「ど…どうして…ここに？ …ああ…思い出した…」\n「お父さんと…お母さんは…ヒュペリア人…私たち…そこから逃げて…エリュシオンへ行くつもりだったけど…」\n「海で船が…黒い渦に…呑み込まれて…」",
    "DialogueId": 6100607,
    "GUID": "0F45B0D6",
    "NextDialogue": 6100608,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100608": {
    "ContentJP": "黒い渦──心当たりがあった。黒潮のことだ。形あるものをすべて呑み込んだ、飢える深淵。",
    "DialogueId": 6100608,
    "GUID": "0F45B100",
    "NextDialogue": 6100609,
    "RougeTalkActorType": 3
  },
  "6100609": {
    "ContentJP": "危険を冒してもエリュシオンへ向かった理由を尋ねる。",
    "DialogueId": 6100609,
    "GUID": "0F45B12A",
    "NextDialogue": 6100610,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100610": {
    "ContentJP": "「私たちは…『悪魔の子』だって…お母さんが。」\n「たとえ深淵に落ちるような災いが起こっても…ヒュペリアに残るよりはまし…」",
    "DialogueId": 6100610,
    "GUID": "0F45B154",
    "NextDialogue": 6100611,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100611": {
    "ContentJP": "「ありがとう…火を貸してくれて、それから…私が生きていないことを教えてくれて。」",
    "DialogueId": 6100611,
    "GUID": "0F45B17E",
    "NextDialogue": 6100612,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100612": {
    "ContentJP": "彼女は消えた。まるで最初から誰もいなかったかのように、隣でパチパチと焚火が音を立てていた。",
    "DialogueId": 6100612,
    "GUID": "0F45B1A8",
    "RougeTalkActorType": 3
  },
  "6100613": {
    "ContentJP": "断る。",
    "DialogueId": 6100613,
    "GUID": "0F45B1D2",
    "IsKeyOption": true,
    "NextDialogue": 6100614,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100614": {
    "ContentJP": "「ご…こめんなさい…お邪魔よね。」",
    "DialogueId": 6100614,
    "GUID": "0F45B1FC",
    "NextDialogue": 6100615,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room306_Char01"
  },
  "6100615": {
    "ContentJP": "少女は震えながら立ち去った。まるで最初から誰もいなかったかのように、隣でパチパチと焚火が音を立てていた。",
    "DialogueId": 6100615,
    "GUID": "0F45B226",
    "RougeTalkActorType": 3
  },
  "6100701": {
    "ContentJP": "「こんにちは！」",
    "DialogueId": 6100701,
    "GUID": "0F45C042",
    "NextDialogue": 6100702,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100702": {
    "ContentJP": "荷物を背負った爽やかな青年が、焚火に歩み寄り、元気に挨拶をした。",
    "DialogueId": 6100702,
    "GUID": "0F45C06C",
    "NextDialogue": 6100703,
    "RougeTalkActorType": 3
  },
  "6100703": {
    "ContentJP": "「ちょっと失礼だけど──君、まだ生きてるよね？」",
    "DialogueId": 6100703,
    "GUID": "0F45C096",
    "NextOptions": [
      6100704,
      6100711
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100704": {
    "ContentJP": "うなずく。",
    "DialogueId": 6100704,
    "GUID": "0F45C0C0",
    "IsKeyOption": true,
    "NextDialogue": 6100705,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100705": {
    "ContentJP": "「まさかこんなところで生きてる人に会えるなんて。どうやら、君は僕と同じ、百人に1人の幸運の持ち主なんだね！」",
    "DialogueId": 6100705,
    "GUID": "0F45C0EA",
    "NextDialogue": 6100706,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100706": {
    "ContentJP": "「十六歳の時、父親と一緒に作った歌が神への冒涜だと言われて、聖裁所に裁かれたんだ。」\n「僕も父親みたいに処刑されるはずだったけど、処刑の日に死刑執行人が雷に打たれたおかげで、赦免された。」",
    "DialogueId": 6100706,
    "GUID": "0F45C114",
    "NextDialogue": 6100707,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100707": {
    "ContentJP": "「二十歳の時は商人の一団に加わってたんだけど、北の森で盗賊に襲われて、洞窟に縛りつけられた。」\n「仲間みたいに餓死するかと思ったけど、7日目の朝、豚が僕を起こしてくれた。近くにいた少女が食べ物をくれたんだ。天使に出会った気分だったね。」",
    "DialogueId": 6100707,
    "GUID": "0F45C13E",
    "NextDialogue": 6100708,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100708": {
    "ContentJP": "「その後、商人として騎士団について深淵に来た。騎士たちの灯りは一つずつ消え、ある騎士は転んだ拍子に自分の剣に喉を刺し貫かれた。生き残ったのは僕だけだ。」\n「その時から、僕は運命の女神に愛されてるんだって信じてる。彼女から授かった幸運と幸福に恵まれてるってね。」",
    "DialogueId": 6100708,
    "GUID": "0F45C168",
    "NextDialogue": 6100709,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100709": {
    "ContentJP": "「彼女が僕をここまで導いたってことは、きっとこの奥に唯一無二の至宝が待っているに違いない。こうしちゃいられない、探しに行かなくちゃ。」\n彼は重そうな荷物を背負い直し、立ち去ろうとしている。",
    "DialogueId": 6100709,
    "GUID": "0F45C192",
    "NextDialogue": 6100710,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100710": {
    "ContentJP": "「そうだ、友よ！君も運命に生かされたってことは、君にもきっと、君だけの幸運が待ってるはずだよ！」\n彼は拳を握りしめ、高らかに笑った。\n「僕たちに幸運あれ！」",
    "DialogueId": 6100710,
    "GUID": "0F45C1BC",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100711": {
    "ContentJP": "倒れて死んだふりをする。",
    "DialogueId": 6100711,
    "GUID": "0F45C1E6",
    "IsKeyOption": true,
    "NextDialogue": 6100712,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100712": {
    "ContentJP": "「気絶してるのか？」\n彼はしゃがみ込み、あなたの息を確認しようとした。\n「まさか、君もやつらと同じ亡霊なのか？」",
    "DialogueId": 6100712,
    "GUID": "0F45C210",
    "NextDialogue": 6100713,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100713": {
    "ContentJP": "あなたは無言のままだ。\n彼は荷物を下ろし、水と食べ物を取り出した。",
    "DialogueId": 6100713,
    "GUID": "0F45C23A",
    "NextDialogue": 6100714,
    "RougeTalkActorType": 3
  },
  "6100714": {
    "ContentJP": "「かわいそうな友よ、これを置いておくよ！聖塔に最初の日差しが差す頃になれば、きっと君も目を覚まして、元通り健康になれるだろう。」",
    "DialogueId": 6100714,
    "GUID": "0F45C264",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room307_Char01"
  },
  "6100801": {
    "ContentJP": "闇の中に、双生の赤い花が咲き、微かに光を放っていた。\nランタンを掲げると、灯りは白みがかった金髪の束と、白い脊椎の数節を照らし出した。これは人型の<Default note=\"text:エジュウ\">穢獣</>なのか、それとも<Default note=\"text:エジュウ\">穢獣</>へと変わりゆく人間なのか？\n警戒して武器を握り締めるが、それは襲いかかってくる様子もなく、漆黒の背景に埋もれた赤い瞳でただ静かにあなたを見つめている。",
    "DialogueId": 6100801,
    "GUID": "0F45D0AA",
    "NextDialogue": 6100802,
    "RougeTalkActorType": 3
  },
  "6100802": {
    "ContentJP": "突然、その喉から、何か壊れた音が漏れた。硬い岩同士が擦れ合うような噪音でありながら、どこかリズムを伴っている。なぜか分からないが、あなたはその意味を理解していた――",
    "DialogueId": 6100802,
    "GUID": "0F45D0D4",
    "NextDialogue": 6100803,
    "RougeTalkActorType": 3
  },
  "6100803": {
    "ContentJP": "「もうこれ以上近づかないで、ランタンの旅人さん。どうか私に教えください。この灯りに映る私の姿は、まだ美しいでしょうか？」",
    "DialogueId": 6100803,
    "GUID": "0F45D0FE",
    "NextDialogue": 6100804,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room308_Char01"
  },
  "6100804": {
    "ContentJP": "「私は髪を柔らかく光るように梳かし、美しいお下げに編みました。」それは後頭部に開いた皮膚を撫でながら言った。\n「私はスカートの折り目にきちんとアイロンかけ、貴く輝く宝石で飾りました。」それは深く体に食い込んだ結晶を撫でながら言った。\n「私は愛する人が贈ったネックレスを身に付け、彼の熱い思いに耽りました。」それは首筋に伸びた骨節を撫でながら言った。",
    "DialogueId": 6100804,
    "GUID": "0F45D128",
    "NextOptions": [
      6100805,
      6100808
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room308_Char01"
  },
  "6100805": {
    "ContentJP": "「ええ、あなたは美しい。」",
    "DialogueId": 6100805,
    "GUID": "0F45D152",
    "IsKeyOption": true,
    "NextDialogue": 6100806,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100806": {
    "ContentJP": "その赤い瞳は風に揺れる花弁のように微かに震えた。",
    "DialogueId": 6100806,
    "GUID": "0F45D17C",
    "NextDialogue": 6100807,
    "RougeTalkActorType": 3
  },
  "6100807": {
    "ContentJP": "「ありがとう、優しい旅人さん。これは私からの謝礼です。」\n「もし私の愛する人にお会いになったら、ずっと彼を愛していると伝えてください。」",
    "DialogueId": 6100807,
    "GUID": "0F45D1A6",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room308_Char01"
  },
  "6100808": {
    "ContentJP": "「お前は恐ろしい怪物だ。」",
    "DialogueId": 6100808,
    "GUID": "0F45D1D0",
    "IsKeyOption": true,
    "NextDialogue": 6100809,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100809": {
    "ContentJP": "その赤い瞳は獰猛たる爪に覆われる。",
    "DialogueId": 6100809,
    "GUID": "0F45D1FA",
    "NextDialogue": 6100810,
    "RougeTalkActorType": 3
  },
  "6100810": {
    "ContentJP": "「あぁ――いや！ 愛する人にこんな醜い姿を見せたくない。」\n「慈悲深き旅人さんよ、どうか私を楽にさせて。」",
    "DialogueId": 6100810,
    "GUID": "0F45D224",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room308_Char01"
  },
  "6100901": {
    "ContentJP": "「ごきげんよう、見知らぬ旅人さん。」",
    "DialogueId": 6100901,
    "GUID": "0F45E112",
    "NextDialogue": 6100902,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6100902": {
    "ContentJP": "派手な服を身に纏った青年が、揺らめく焚火の明かりの前で足を止め、優雅にお辞儀をした。",
    "DialogueId": 6100902,
    "GUID": "0F45E13C",
    "NextDialogue": 6100903,
    "RougeTalkActorType": 3
  },
  "6100903": {
    "ContentJP": "「私は赤い瞳をした淑女を探しております。彼女の姿を見かけませんでしたか？」",
    "DialogueId": 6100903,
    "GUID": "0F45E166",
    "NextDialogue": 6100904,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6100904": {
    "ContentJP": "「彼女はこの世で最も美しい歌声の持ち主で、夜鶯さえも彼女には劣ります。」\n「柔らかな金色の髪は、春に咲くマリーゴールドのように輝いています。」\n「気品のあるワンピースを纏い、スカートには星のようにきらめく宝石が縫い込まれています。」\n「そして私が贈ったネックレスを身につけています。真紅の水晶は、彼女が私を見つめる時の瞳のように神秘的な輝きを放っています。」",
    "DialogueId": 6100904,
    "GUID": "0F45E190",
    "NextDialogue": 6100905,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6100905": {
    "ContentJP": "そんな女性は見たことがない。",
    "DialogueId": 6100905,
    "GUID": "0F45E1BA",
    "NextDialogue": 6100906,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100906": {
    "ContentJP": "「そうですか…」\n彼は一瞬項垂れたが、すぐに元の表情に戻った。\n「構いません、私はこれからも探し続けます。」",
    "DialogueId": 6100906,
    "GUID": "0F45E1E4",
    "NextDialogue": 6100907,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6100907": {
    "ContentJP": "青年は焚火の傍に腰を下ろした。明るい炎が彼の澄んだ瞳に映り込んだ。",
    "DialogueId": 6100907,
    "GUID": "0F45E20E",
    "NextDialogue": 6100908,
    "RougeTalkActorType": 3
  },
  "6100908": {
    "ContentJP": "「私たちはすでに婚約しており、彼女が成人したら結婚式を挙げる予定でした。しかし彼女は神の恩寵を受け、額の聖痕が次第に明らかになり、十四歳の前夜に使者に連れ去られたのです。」\n「彼女は別れの手紙を残し、私に他の女性を探すよう勧めました。ですが、私は既に誓いを立てています。この生涯は彼女と共に過ごしたい。」\n「彼女を見つけたら、絶対に連れ帰ります。満月の神は人々に愛の美しさを謳うよう教えられた方です。きっと私たちを祝福してくださるでしょう。」",
    "DialogueId": 6100908,
    "GUID": "0F45E238",
    "NextOptions": [
      6100909,
      6100911
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6100909": {
    "ContentJP": "恋人を見つけられるよう祈る。",
    "DialogueId": 6100909,
    "GUID": "0F45E262",
    "IsKeyOption": true,
    "NextDialogue": 6100910,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100910": {
    "ContentJP": "「感謝します、優しい旅人さん。」\n「このささやかな贈り物を受け取ってください。あなたも望みが叶いますように。」",
    "DialogueId": 6100910,
    "GUID": "0F45E28C",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6100911": {
    "ContentJP": "「もし神が許さなかったら？」",
    "DialogueId": 6100911,
    "GUID": "0F45E2B6",
    "IsKeyOption": true,
    "NextDialogue": 6100912,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6100912": {
    "ContentJP": "彼はあなたに小さく微笑んだ。\n「ならば、この身を聖なる湖に捧げましょう。そうすれば、私の魂は永遠に彼女と共にあることができます。」",
    "DialogueId": 6100912,
    "GUID": "0F45E2E0",
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room309_Char01"
  },
  "6101001": {
    "ContentJP": "焚火の傍に女の姿が浮かび上がった。彼女は左手を燃え盛る焚火に差し入れ、煤を指に取り、地面にあなたが読めない文字を書きつけていく。",
    "DialogueId": 6101001,
    "GUID": "0F45F17A",
    "NextDialogue": 6101002,
    "RougeTalkActorType": 3
  },
  "6101002": {
    "ContentJP": "「ああ――時に抗う旅人よ、君は絶望と共にあり、死は影のごとく付き従う。」\n彼女はそう囁くように詠んだ。",
    "DialogueId": 6101002,
    "GUID": "0F45F1A4",
    "NextOptions": [
      6101003,
      6101005
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room310_Char01"
  },
  "6101003": {
    "ContentJP": "何をしているのかと尋ねる",
    "DialogueId": 6101003,
    "GUID": "0F45F1CE",
    "IsKeyOption": true,
    "NextDialogue": 6101004,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101004": {
    "ContentJP": "「おお、親愛なる友よ。ご覧の通り、私は詩人だ。」\n「今まさに、私の101首目の作品を創作中さ。そう、あなたに捧げる詩だ！」",
    "DialogueId": 6101004,
    "GUID": "0F45F1F8",
    "NextDialogue": 6101008,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room310_Char01"
  },
  "6101005": {
    "ContentJP": "「火が熱くないのか？」",
    "DialogueId": 6101005,
    "GUID": "0F45F222",
    "IsKeyOption": true,
    "NextDialogue": 6101006,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101006": {
    "ContentJP": "女はくすくすと笑った。",
    "DialogueId": 6101006,
    "GUID": "0F45F24C",
    "NextDialogue": 6101007,
    "RougeTalkActorType": 3
  },
  "6101007": {
    "ContentJP": "「親愛なる友よ、これを見て。」\n彼女は掌をあなたの目の前に広げた。白い肌には傷1つない。\n「あなたのように賢明な旅人ならとっくにお気づきでしょう。これは本物の炎ではなく、私も本物の人間ではない。」",
    "DialogueId": 6101007,
    "GUID": "0F45F276",
    "NextDialogue": 6101008,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room310_Char01"
  },
  "6101008": {
    "ContentJP": "詩人は再び焚火に手を伸ばし、炎を優雅に指先でかき混ぜた。そのしなやかな指の動きは、まるで踊り子の足踏みのようだった。",
    "DialogueId": 6101008,
    "GUID": "0F45F2A0",
    "NextDialogue": 6101009,
    "RougeTalkActorType": 3
  },
  "6101009": {
    "ContentJP": "「ここは実に素敵な場所だよね？」\n「私はついに肉体の苦痛から解放され、つまらないことに創作を邪魔されることもなくなった。至上の自由と、永遠の時を手に入れた――！」\n「旅人よ、ここに足を止めてくれてありがとう。おかげで一片の閃きが得られた。ぜひ私の詩を受け取ってほしい。どうかあなたがこの無限の輪廻から解き放たれ、望みを叶えられますように。」",
    "DialogueId": 6101009,
    "GUID": "0F45F2CA",
    "NextDialogue": 6101010,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room310_Char01"
  },
  "6101010": {
    "ContentJP": "詩人があなたに手を差し伸べると、舞い上がるすすが嵐のようにあなたの視界を覆い尽くした。\nすすが散った時、詩人の姿はどこにも見当たらなかった。",
    "DialogueId": 6101010,
    "GUID": "0F45F2F4",
    "RougeTalkActorType": 3
  },
  "6101101": {
    "ContentJP": "「こんにちは。どうか、この火を分けてください。」",
    "DialogueId": 6101101,
    "GUID": "0F4601E2",
    "NextDialogue": 6101102,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room311_Char01"
  },
  "6101102": {
    "ContentJP": "少年はわざとらしい格式ばった歩き方で、ゆっくりと焚火の傍に腰を下ろした。\n彼は大きすぎる礼服を纏い、痩せた小さな体が一層みすぼらしく見えた。火の光を借りて薄い本を捧げ持ち、本を読み始めるその仕草は、妙に気取っているように見えた。",
    "DialogueId": 6101102,
    "GUID": "0F46020C",
    "NextDialogue": 6101103,
    "RougeTalkActorType": 3
  },
  "6101103": {
    "ContentJP": "「炎の神よ、我らに知恵を授けたまえ…水の神よ、我らに豊穣を授けたまえ…」",
    "DialogueId": 6101103,
    "GUID": "0F460236",
    "NextOptions": [
      6101104
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room311_Char01"
  },
  "6101104": {
    "ContentJP": "何を読んでいる？",
    "DialogueId": 6101104,
    "GUID": "0F460260",
    "NextDialogue": 6101105,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101105": {
    "ContentJP": "「ああ、これは兄さんたちがくれた本だ。」彼は照れくさそうに頭を掻いた。「神様にお会いする前にもっと賢くならなきゃいけないんだ。」\n「僕は小さい頃から家族で一番頭の悪い子だった。兄さんたちはみんな僕よりずっと優秀なのに、どういうわけか神様に選ばれたのは僕だった。みんなおかしいって言ってる。」\n「兄さんたちがこの聖歌集をくれて、九神に拝謁する前にちゃんと覚えて、家族の恥にならないようにしろって言ったんだ。」",
    "DialogueId": 6101105,
    "GUID": "0F46028A",
    "NextDialogue": 6101106,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room311_Char01"
  },
  "6101106": {
    "ContentJP": "少年は体をずらし、あなたに近づくと、手に持った本を差し出しながら誘うような視線を投げかけた。",
    "DialogueId": 6101106,
    "GUID": "0F4602B4",
    "NextDialogue": 6101107,
    "RougeTalkActorType": 3
  },
  "6101107": {
    "ContentJP": "「一緒に見ない？」",
    "DialogueId": 6101107,
    "GUID": "0F4602DE",
    "NextOptions": [
      6101108,
      6101112
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room311_Char01"
  },
  "6101108": {
    "ContentJP": "一緒に本を見る。",
    "DialogueId": 6101108,
    "GUID": "0F460308",
    "IsKeyOption": true,
    "NextDialogue": 6101109,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101109": {
    "ContentJP": "あなたは誘いに乗り、視線を本に向けた。驚いたことに、そこには真っ黒な筆跡で、想像もつかない悪意に満ちた卑俗な言葉がびっしりと書き込まれていた。\n次の瞬間、文字が黒い棘と化して紙面から飛び出し、獲物を狙う毒蛇のようにあなたの体に絡みついた。視界はどんどん暗く、ぼやけていく。\n本能的に、あなたは体を反らせて視線を本から引き剥がした。",
    "DialogueId": 6101109,
    "GUID": "0F460332",
    "NextDialogue": 6101110,
    "RougeTalkActorType": 3
  },
  "6101110": {
    "ContentJP": "「え？ どうしたの？ 本に何か怖いものでも書いてあった？」\n彼は純粋な眼差しで、困惑しながらあなたを見つめた。",
    "DialogueId": 6101110,
    "GUID": "0F46035C",
    "NextDialogue": 6101111,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room311_Char01"
  },
  "6101111": {
    "ContentJP": "あなたは唇を開いたが、声が出ない。\n黒い棘が少年を包み、吞み込んでいく。少年も、本も、棘も、やがて全てが消え去った。",
    "DialogueId": 6101111,
    "GUID": "0F460386",
    "RougeTalkActorType": 3
  },
  "6101112": {
    "ContentJP": "一緒に本を読むのを断る",
    "DialogueId": 6101112,
    "GUID": "0F4603B0",
    "IsKeyOption": true,
    "NextDialogue": 6101113,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101113": {
    "ContentJP": "ここで勉強するつもりはなかったが。",
    "DialogueId": 6101113,
    "GUID": "0F4603DA",
    "NextDialogue": 6101114,
    "RougeTalkActorType": 3
  },
  "6101114": {
    "ContentJP": "「そっか……それじゃ、僕一人で読む。」\n彼は本を膝の上に戻した。",
    "DialogueId": 6101114,
    "GUID": "0F460404",
    "NextDialogue": 6101115,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room311_Char01"
  },
  "6101115": {
    "ContentJP": "突然、ページの間から無数の黒い棘が蠢き出た。\n驚く間もなく、黒い棘が少年を包み、吞み込んでいく。少年も、本も、棘も、やがて全てが消え去った。",
    "DialogueId": 6101115,
    "GUID": "0F46042E",
    "RougeTalkActorType": 3
  },
  "6101201": {
    "ContentJP": "一人の中年女性が焚火の前に深刻な面持ちで腰を下ろした。炎の光は彼女の陰った瞳を照らさなかった。",
    "DialogueId": 6101201,
    "GUID": "0F46124A",
    "NextDialogue": 6101202,
    "RougeTalkActorType": 3
  },
  "6101202": {
    "ContentJP": "「こんにちは、見知らぬ方よ。失礼ながらお聞きしたいのですが、ここはどこなのでしょうか？」",
    "DialogueId": 6101202,
    "GUID": "0F461274",
    "NextDialogue": 6101203,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101203": {
    "ContentJP": "答える。",
    "DialogueId": 6101203,
    "GUID": "0F46129E",
    "NextDialogue": 6101204,
    "RougeTalkActorType": 3
  },
  "6101204": {
    "ContentJP": "「聖湖…？深淵…？」彼女の声は混乱と困惑に満ちていた「でも、私はそういった言葉に全く覚えがなくて…」\n彼女は自分の皺だらけの手のひらを見つめた。「私は、どうしてここに来たのか忘れてしまったようです。」",
    "DialogueId": 6101204,
    "GUID": "0F4612C8",
    "NextOptions": [
      6101205,
      6101207
    ],
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101205": {
    "ContentJP": "彼女に聖湖の歴史を教える。",
    "DialogueId": 6101205,
    "GUID": "0F4612F2",
    "IsKeyOption": true,
    "NextDialogue": 6101206,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101206": {
    "ContentJP": "「体に聖痕が現れた人は…ここに連れてこられる…？」\n「ああ…思い出しました。私の子供がここにいるはずです。彼女の目元に、まるで羽ばたこうとする蝶のような聖痕が現れたのです。」",
    "DialogueId": 6101206,
    "GUID": "0F46131C",
    "NextDialogue": 6101210,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101207": {
    "ContentJP": "自分の持ち物を調べるよう勧める。",
    "DialogueId": 6101207,
    "GUID": "0F461346",
    "IsKeyOption": true,
    "NextDialogue": 6101208,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101208": {
    "ContentJP": "「あなたの言う通りですね。」\n彼女はポケットに手を入れ、銀のブローチを取り出した。",
    "DialogueId": 6101208,
    "GUID": "0F461370",
    "NextDialogue": 6101209,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101209": {
    "ContentJP": "「ああ…思い出しました。」彼女は袖でブローチを丁寧に拭く。「これはあの子に贈るはずのプレゼントでした。」",
    "DialogueId": 6101209,
    "GUID": "0F46139A",
    "NextDialogue": 6101210,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101210": {
    "ContentJP": "女は顔を上げた。今、炎の光がはっきりと彼女の瞳に映っている。",
    "DialogueId": 6101210,
    "GUID": "0F4613C4",
    "NextDialogue": 6101211,
    "RougeTalkActorType": 3
  },
  "6101211": {
    "ContentJP": "「私は子供を探しに来たのです。」\n「私が留守の間に、眠っている彼女を連れ去られました。あの子は小さい頃から人見知りが激しくて、目を覚ました時に知らない人ばかりだったらきっと怖がるはず。」\n「彼女のそばにいなければ…そう、私は彼女を探しに来たのです。」",
    "DialogueId": 6101211,
    "GUID": "0F4613EE",
    "NextDialogue": 6101212,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101212": {
    "ContentJP": "「彼女がいなくなってからどれくらい経つか？」",
    "DialogueId": 6101212,
    "GUID": "0F461418",
    "NextDialogue": 6101213,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101213": {
    "ContentJP": "「十日前…いや、十か月…いえ、十年…ああ…忘れてしまいました。」",
    "DialogueId": 6101213,
    "GUID": "0F461442",
    "NextDialogue": 6101214,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room312_Char01"
  },
  "6101214": {
    "ContentJP": "女は黙り込んだ。彼女は異常な放心状態に陥り、全身が静止し、呼吸さえも止まったように見えた。\n何を言おうと、彼女はもう何の反応も示してくれなかった。",
    "DialogueId": 6101214,
    "GUID": "0F46146C",
    "RougeTalkActorType": 3
  },
  "6101301": {
    "ContentJP": "「ボッ──」\n突然、目の前の焚火が勢いを増した。\n金髪の少女がスカートに金色の小石を抱え、一つ一つ火の中に投げ入れているのに気づく。",
    "DialogueId": 6101301,
    "GUID": "0F4622B2",
    "NextDialogue": 6101302,
    "RougeTalkActorType": 3
  },
  "6101302": {
    "ContentJP": "火の勢いは益々強くなり、まるで最初の春を迎えた植物のように勢い良く、無限に枝を伸ばし始めた。",
    "DialogueId": 6101302,
    "GUID": "0F4622DC",
    "NextOptions": [
      6101303,
      6101305
    ],
    "RougeTalkActorType": 3
  },
  "6101303": {
    "ContentJP": "炎の美しさを褒める",
    "DialogueId": 6101303,
    "GUID": "0F462306",
    "IsKeyOption": true,
    "NextDialogue": 6101304,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101304": {
    "ContentJP": "「ええ！」彼女は炎のように熱烈な声で答えた。「同じ考えの人がいて嬉しいな。」",
    "DialogueId": 6101304,
    "GUID": "0F462330",
    "NextDialogue": 6101307,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room313_Char01"
  },
  "6101305": {
    "ContentJP": "石の由来を尋ねる",
    "DialogueId": 6101305,
    "GUID": "0F46235A",
    "IsKeyOption": true,
    "NextDialogue": 6101306,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101306": {
    "ContentJP": "「この辺で拾った石よ。」彼女は説明した。「多分、何かの炎魔法の結晶だと思う。」",
    "DialogueId": 6101306,
    "GUID": "0F462384",
    "NextDialogue": 6101307,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room313_Char01"
  },
  "6101307": {
    "ContentJP": "少女は石を投げ続ける。錯覚だろうか、炎は少女にますます近づき、金色の髪を優しく舐めるように揺らめいている。",
    "DialogueId": 6101307,
    "GUID": "0F4623AE",
    "NextDialogue": 6101308,
    "RougeTalkActorType": 3
  },
  "6101308": {
    "ContentJP": "「明日になれば、焚火は元通り。この小石もまた辺りに散らばる。」\n「だから毎日、石を拾っては投げ入れてるの。146個、多くも少なくもなく。」",
    "DialogueId": 6101308,
    "GUID": "0F4623D8",
    "NextDialogue": 6101309,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room313_Char01"
  },
  "6101309": {
    "ContentJP": "「無意味じゃないか？」",
    "DialogueId": 6101309,
    "GUID": "0F462402",
    "NextDialogue": 6101310,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101310": {
    "ContentJP": "少女は首を傾げ、瞬きながら無邪気な笑顔を見せる。",
    "DialogueId": 6101310,
    "GUID": "0F46242C",
    "NextDialogue": 6101311,
    "RougeTalkActorType": 3
  },
  "6101311": {
    "ContentJP": "「いいえ、私は火が好き。」彼女は言った。「燃える音も、踊る姿も好き。」\n「ここの空間は入り乱れている。目を閉じた時は焚火の傍にいても、次に目を開ければ湖の底にいたりする。」\n「でもこの小石は違う。環境がどう変わろうと、必ずまた現れる。明日も見つけられると思うと、安心して眠れるの。」",
    "DialogueId": 6101311,
    "GUID": "0F462456",
    "NextDialogue": 6101312,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room313_Char01"
  },
  "6101312": {
    "ContentJP": "「私は確かなものが好き。」",
    "DialogueId": 6101312,
    "GUID": "0F462480",
    "NextDialogue": 6101313,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room313_Char01"
  },
  "6101313": {
    "ContentJP": "少女は最後の石を投げた。\n炎の光に完全に包まれ、金髪と炎の境界はもはや見分けがつかない。",
    "DialogueId": 6101313,
    "GUID": "0F4624AA",
    "RougeTalkActorType": 3
  },
  "6101401": {
    "ContentJP": "「う…ぐっ…」",
    "DialogueId": 6101401,
    "GUID": "0F46331A",
    "NextDialogue": 6101402,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room314_Char01"
  },
  "6101402": {
    "ContentJP": "か細い呻き声が低い位置から聞こえる。焚火の傍に、飢えに苦しんでいるらしい痩せこけた男が倒れているのに気づいた。",
    "DialogueId": 6101402,
    "GUID": "0F463344",
    "NextOptions": [
      6101403,
      6101409
    ],
    "RougeTalkActorType": 3
  },
  "6101403": {
    "ContentJP": "食べ物を分ける",
    "DialogueId": 6101403,
    "GUID": "0F46336E",
    "IsKeyOption": true,
    "NextDialogue": 6101404,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101404": {
    "ContentJP": "「…ありがとう、優しい子だね。だが、もう食べ物は必要ないんだ。」\n「黒潮に呑まれて、もう戻れない以上、どれだけ食べても無意味だ。」\n「君を見ていると、エリュシオンにいる女の子を思い出す…君と同じように優しい子だった。」",
    "DialogueId": 6101404,
    "GUID": "0F463398",
    "NextDialogue": 6101405,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room314_Char01"
  },
  "6101405": {
    "ContentJP": "「金髪の女の子で、ピンクの巨大な豚に乗っていた。私が飢えで街を彷徨っていた時、パン一切れを差し出してくれた…」\n「だが当時の私は高慢で、礼賛会の施しなど受け入れられなかった。子供の善意と知りながら、大声で罵倒してしまった。」",
    "DialogueId": 6101405,
    "GUID": "0F4633C2",
    "NextDialogue": 6101406,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room314_Char01"
  },
  "6101406": {
    "ContentJP": "「今となって、自分の人生を振り返って…彼女だけが真心から私に接してくれたのだと初めて気づいたよ。」\n「信仰や種族、出身…人はいつもそんなもので……自分を飾り立てる…だが、どんな肩書も、真の優しさが放つ輝きには勝てない…」",
    "DialogueId": 6101406,
    "GUID": "0F4633EC",
    "NextDialogue": 6101407,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room314_Char01"
  },
  "6101407": {
    "ContentJP": "「もし戻れたら…直接謝りたかった…ただ…もう…チャンスはないようだ…」",
    "DialogueId": 6101407,
    "GUID": "0F463416",
    "NextDialogue": 6101408,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room314_Char01"
  },
  "6101408": {
    "ContentJP": "男の声は次第に小さくなり、瞬きをすると彼の姿は消えていた。\n空気中に、焼きたてのパンの香りが漂ってくる。",
    "DialogueId": 6101408,
    "GUID": "0F463440",
    "RougeTalkActorType": 3
  },
  "6101409": {
    "ContentJP": "何もしない",
    "DialogueId": 6101409,
    "GUID": "0F46346A",
    "IsKeyOption": true,
    "NextDialogue": 6101410,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101410": {
    "ContentJP": "男は確かに可哀想に見えるが、自分の持ち物もほとんど残っていない。\nこの危険な深淵では、まず自分が生き延びることを最優先にすべきだ。",
    "DialogueId": 6101410,
    "GUID": "0F463494",
    "RougeTalkActorType": 3
  },
  "6101501": {
    "ContentJP": "一筋の金色の光が空中に閃いた。一瞬、太陽が昇ったかと思ったが、よく見ればそれは全身が黄金色の小鳥だった。\n空から旋回しながら降りてきた鳥は、あなたの傍に優雅に着地し、羽を収めた。焚火に照らされた金色の羽はきらめき、貴族の令嬢たちが秘蔵する金細工よりも、精緻な輝きを放っている。",
    "DialogueId": 6101501,
    "GUID": "0F464382",
    "NextOptions": [
      6101502,
      6101505,
      6101509
    ],
    "RougeTalkActorType": 3
  },
  "6101502": {
    "ContentJP": "鳥に水をやる",
    "DialogueId": 6101502,
    "GUID": "0F4643AC",
    "IsKeyOption": true,
    "NextDialogue": 6101503,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101503": {
    "ContentJP": "手のひらに水を溜め、鳥に差し伸べる。",
    "DialogueId": 6101503,
    "GUID": "0F4643D6",
    "NextDialogue": 6101504,
    "RougeTalkActorType": 3
  },
  "6101504": {
    "ContentJP": "小鳥は首を傾げ、警戒しながらあなたを観察する。しばらくして、ためらいがちに金色の嘴を降ろし、手のひらの水を少しずつ飲み始めた。\n水を飲み終えると、羽を楽しげに振るわせて感謝の鳴き声をあげ、空へと舞い上がっていった。",
    "DialogueId": 6101504,
    "GUID": "0F464400",
    "RougeTalkActorType": 3
  },
  "6101505": {
    "ContentJP": "鳥の尾羽を抜いてみる",
    "DialogueId": 6101505,
    "GUID": "0F46442A",
    "IsKeyOption": true,
    "NextDialogue": 6101506,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101506": {
    "ContentJP": "こっそり手を伸ばし、鳥が目を閉じて休んでいる隙に尾羽を一本抜き取る――羽の質感はまるで上質な黄金のようで、きっと高価に違いない。",
    "DialogueId": 6101506,
    "GUID": "0F464454",
    "NextDialogue": 6101507,
    "RougeTalkActorType": 3
  },
  "6101507": {
    "ContentJP": "鳥は怒りの鳴き声をあげ、羽ばたきながらあなたに襲いかかる。その嘴の一撃は、高熱を持つ溶けた金が手のひらに滴り落ちたかのような激痛で、鮮やかな赤い痕を残した。",
    "DialogueId": 6101507,
    "GUID": "0F46447E",
    "NextDialogue": 6101508,
    "RougeTalkActorType": 3
  },
  "6101508": {
    "ContentJP": "激痛が引いた頃には、鳥は遥か上空へ飛び去っていた。",
    "DialogueId": 6101508,
    "GUID": "0F4644A8",
    "RougeTalkActorType": 3
  },
  "6101509": {
    "ContentJP": "鳥の頭の羽を抜いてみる",
    "DialogueId": 6101509,
    "GUID": "0F4644D2",
    "IsKeyOption": true,
    "NextDialogue": 6101510,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101510": {
    "ContentJP": "そっと手を伸ばし頭の羽を狙うが、力が入る前に鳥はあなたの動向に気づき、ぱっちりと目を見開いた。\n鳥は怒りの鳴き声をあげ、羽ばたきながらあなたに襲いかかる。その嘴の一撃は、高熱を持つ溶けた金が手のひらに滴り落ちたかのような激痛で、鮮やかな赤い痕を残した。",
    "DialogueId": 6101510,
    "GUID": "0F4644FC",
    "NextDialogue": 6101511,
    "RougeTalkActorType": 3
  },
  "6101511": {
    "ContentJP": "激痛が引いた頃には、鳥は遥か上空へ飛び去っていた。",
    "DialogueId": 6101511,
    "GUID": "0F464526",
    "RougeTalkActorType": 3
  },
  "6101601": {
    "ContentJP": "腐敗した生臭い匂いが近くから漂ってきた。\n焚火の傍に小さな女の子が現れた。彼女の頬や腕には恐ろしい膿瘍が広がっており、焚火の明かりに照らされた瞳だけがかすかな生命の輝きを放っていなければ、目の前の存在が死体だと錯覚するところだった。",
    "DialogueId": 6101601,
    "GUID": "0F4653EA",
    "NextOptions": [
      6101602,
      6101606,
      6101612
    ],
    "RougeTalkActorType": 3
  },
  "6101602": {
    "ContentJP": "バッグから薬を取り出し、少女に手渡す。",
    "DialogueId": 6101602,
    "GUID": "0F465414",
    "IsKeyOption": true,
    "NextDialogue": 6101603,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101603": {
    "ContentJP": "「ありがとう…ございます…優しい旅人さん…」\nゆっくりと顔を上げる少女。その引きつった口元が、笑みなのか痛みによる痙攣なのか、判別できなかった。",
    "DialogueId": 6101603,
    "GUID": "0F46543E",
    "NextDialogue": 6101604,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room316_Char01"
  },
  "6101604": {
    "ContentJP": "「でも…どうか…助けなくて結構です…」声をひそめて言った。「司祭様がおっしゃいました。私は呪われて、深淵病にかかっている。これは私の罪だと…」\n「心から懺悔すれば…きっと治る…それまでは、誰にも近づいてはいけないのです」",
    "DialogueId": 6101604,
    "GUID": "0F465468",
    "NextDialogue": 6101605,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room316_Char01"
  },
  "6101605": {
    "ContentJP": "少女はよろめきながら立ち上がり、闇の中に消えていった。",
    "DialogueId": 6101605,
    "GUID": "0F465492",
    "RougeTalkActorType": 3
  },
  "6101606": {
    "ContentJP": "少女の傷を治療しようとする",
    "DialogueId": 6101606,
    "GUID": "0F4654BC",
    "IsKeyOption": true,
    "NextDialogue": 6101607,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101607": {
    "ContentJP": "慎重に近づき、少女の傷の状態を調べようとする。",
    "DialogueId": 6101607,
    "GUID": "0F4654E6",
    "NextDialogue": 6101608,
    "RougeTalkActorType": 3
  },
  "6101608": {
    "ContentJP": "「げほっ…げほっ…！」\n激しい咳込みと共に、どす黒い血があなたの手にかかる。血は不気味な黒煙を立ち上らせた。",
    "DialogueId": 6101608,
    "GUID": "0F465510",
    "NextDialogue": 6101609,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room316_Char01"
  },
  "6101609": {
    "ContentJP": "「ご…ごめんなさい…！」\nふらふらと立ち上がろうとして、またもや地面に倒れ込む。",
    "DialogueId": 6101609,
    "GUID": "0F46553A",
    "NextDialogue": 6101610,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room316_Char01"
  },
  "6101610": {
    "ContentJP": "「司祭様がおっしゃいました。私は呪われて、深淵病にかかっている。これは私の罪だと…」\n「心から懺悔すれば…きっと治る…それまでは、誰にも近づいてはいけないのです」",
    "DialogueId": 6101610,
    "GUID": "0F465564",
    "NextDialogue": 6101611,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room316_Char01"
  },
  "6101611": {
    "ContentJP": "少女は再び苦しそうに起き上がり、よろめきながら闇に消えた。",
    "DialogueId": 6101611,
    "GUID": "0F46558E",
    "RougeTalkActorType": 3
  },
  "6101612": {
    "ContentJP": "距離を取る",
    "DialogueId": 6101612,
    "GUID": "0F4655B8",
    "IsKeyOption": true,
    "NextDialogue": 6101613,
    "RougeTalkActorType": 2,
    "SpeakNpcId": 910004
  },
  "6101613": {
    "ContentJP": "直感が少女の病の危険性を告げていた。あなたは立ち上がり、距離を取った。",
    "DialogueId": 6101613,
    "GUID": "0F4655E2",
    "NextDialogue": 6101614,
    "RougeTalkActorType": 3
  },
  "6101614": {
    "ContentJP": "「すみません…驚かせてしまって…私…すぐに立ち去ります…」",
    "DialogueId": 6101614,
    "GUID": "0F46560C",
    "NextDialogue": 6101615,
    "RougeTalkActorType": 1,
    "SpeakNpcId": 910005,
    "SpeakNpcName": "RougeLike_Room316_Char01"
  },
  "6101615": {
    "ContentJP": "少女はよろめきながら立ち上がり、闇の中に消えていった。",
    "DialogueId": 6101615,
    "GUID": "0F465636",
    "RougeTalkActorType": 3
  },
  "6101701": {
    "ContentJP": "あなたは焚火の傍に腰を下ろして休憩を取ることにし、手にしていたランタンを足元に置いた。\nその瞬間、地面が突然、水のような光を放ち始めた。反応する間もなく、ランタンは渦巻く水に吞み込まれてしまった。",
    "DialogueId": 6101701,
    "GUID": "0F466452",
    "NextDialogue": 6101702,
    "RougeTalkActorType": 3
  },
  "6101702": {
    "ContentJP": "滑稽な鳥頭の仮面をした人が水中から上半身を現し、頭を振ると、両手を広げた――水上に、形は同じだが材質の異なる三つのランタンが浮かび上がった。",
    "DialogueId": 6101702,
    "GUID": "0F46647C",
    "NextDialogue": 6101703,
    "RougeTalkActorType": 3
  }
}